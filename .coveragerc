[run]
branch = True
source = .
omit =
    *tests*
    *setup.py
    *.github*
    *venv*
    *virtualenv*

[report]
show_missing = True
precision = 2
# Ratchet, not target: raised 55 -> 56 on 2026-10-05 with
# tests/unit/test_unit_input_validation.py (input_validation.py at 98%,
# ~64 newly covered statements). Raise as coverage grows (#88); never lower.
fail_under = 56
